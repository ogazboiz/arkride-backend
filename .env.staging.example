# =============================================================================
# Ark Rides — STAGING  (copy to .env.staging; compose.local.yml reads it)
# =============================================================================
# Only the values that DIFFER from .env.example are listed. Everything there
# still applies.
#
# The app validates this on boot and refuses to start if anything required is
# missing, so a successful start means this file is complete.
# =============================================================================

NODE_ENV=staging
PORT=4010

# REQUIRED — a DIFFERENT secret from production. Sharing one means a staging
# token is a production token.
#   openssl rand -base64 48
JWT_SECRET=

# Staging database and Redis.
DATABASE_URL=
DATABASE_SSL=true
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# REQUIRED outside development — the app will not start without them.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Privy: the same shared WorldStreet application as production. Identity is
# not environment-specific, so these are the values from
# wsws-monorepo/apps/market-square/.env.
PRIVY_APP_ID=cmrv8k0hd00b40cldl4p0d08g
PRIVY_VERIFICATION_KEY=

# REQUIRED — unset, no browser cross-origin request is allowed at all.
CORS_ORIGINS=https://staging.arkrides.com

#   openssl rand -hex 32
INTERNAL_API_KEY=

# Recorded and broadcast in-app regardless; unset, no EXTERNAL party is told.
EMERGENCY_WEBHOOK_URLS=

APP_NAME=Ark Rides (Staging)
KEKE_WEBSITE_URL=https://staging.arkrides.com
REPORTING_TIMEZONE=Africa/Lagos

MFB_PROVIDER=simulated
LINKPAY_PROVIDER=simulated
MFB_DAILY_FUEL_LIMIT=5000

# Swagger is OFF outside development unless this is explicitly true.
# Reasonable to enable on staging; never on production.
ENABLE_SWAGGER=true
