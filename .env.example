# =============================================================================
# Ark Rides — backend environment
# =============================================================================
# Copy to `.env` and fill in. `validateEnvironment()` runs before the app is
# constructed and REFUSES TO START when anything required here is missing,
# blank, or left as a placeholder — see src/config/env.validation.ts.
#
# Variables are grouped by what breaks without them.
# =============================================================================


# --- Required in every environment, including local -------------------------

# Signs and verifies every access token. Minimum 32 characters.
#
# There is no default and there must never be one: four call sites used to fall
# back to the literal string 'your-secret-key', so an unset secret meant anyone
# who had read the repository could mint an admin token.
#
#   openssl rand -base64 48
JWT_SECRET=


# --- Database ---------------------------------------------------------------
# Supply DATABASE_URL, or the discrete parts. Required outside development.

DATABASE_URL=
# DATABASE_HOST=postgres
# DATABASE_PORT=5432
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_NAME=arkrides

# TLS to the database. Note the connection currently sets
# rejectUnauthorized:false, so this encrypts but does not authenticate the
# server — fine for a managed provider on a private network, not a substitute
# for certificate verification.
DATABASE_SSL=false

# Escape hatch ONLY. Lets TypeORM reshape your local database from the
# entities. Ignored unless NODE_ENV=development. Leaving this on is what let
# the schema drift away from the migrations in the first place.
# DB_SYNCHRONIZE=false


# --- Redis ------------------------------------------------------------------
# Ride locking, driver geo lookups, rate limiting and the BullMQ queues.
# Required outside development.

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=


# --- Privy (WorldStreet single sign-on) -------------------------------------
# Ark Rides shares ONE Privy application with the rest of WorldStreet, so a
# rider who already has a Market Square account signs in with the same
# identity. Both values come from the Privy dashboard for that app.
#
# Unset, POST /api/v1/auth/privy returns 503 and email/password login is
# unaffected — Privy is additive, not a replacement.
#
# The verification key is a P-256 SPKI PEM. Store it with literal \n escapes on
# one line, as below; the service unescapes them.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=


# --- Email (SendGrid) -------------------------------------------------------
# OTP and password-reset delivery. Required outside development; without them
# every email job fails three times and dies silently.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
APP_NAME=Ark Rides
KEKE_WEBSITE_URL=https://arkrides.com


# --- Off-app booking channels ----------------------------------------------
# Shared secret for the WhatsApp/voice ingress at
# POST /api/v1/booking-channels/parse-and-book. The guard fails CLOSED when
# unset, so that endpoint simply refuses everything until this is configured.
INTERNAL_API_KEY=


# --- CORS -------------------------------------------------------------------
# Comma-separated browser origins. Covers BOTH the REST API and the Socket.IO
# handshake — they used to have two separate, independently wide-open policies.
# Unset outside development means no cross-origin browser request is allowed.
CORS_ORIGINS=https://arkrides.com,https://app.arkrides.com


# --- Emergency (SOS) --------------------------------------------------------
# Comma-separated webhook URLs notified when a rider or driver raises an SOS.
# Unset, the incident is still recorded and broadcast in-app but NO EXTERNAL
# PARTY IS TOLD. Treat this as required for any environment carrying real
# passengers.
EMERGENCY_WEBHOOK_URLS=


# --- Driver wallet ----------------------------------------------------------
# Both providers are SIMULATED and the module refuses to boot with any other
# value — real disbursement and payout integrations are not written yet.
MFB_PROVIDER=simulated
LINKPAY_PROVIDER=simulated
MFB_DAILY_FUEL_LIMIT=5000


# --- Decane (legacy wallet SSO) --------------------------------------------
# Optional. Unset, DecaneService starts unscoped and POST /auth/decane fails.
DECANE_APP_ID=
DECANE_VERIFICATION_KEY=
DECANE_API_KEY=
DECANE_API_BASE=


# --- Runtime ----------------------------------------------------------------
# REQUIRED. One of: development | test | staging | production.
#
# The app refuses to start without it, on purpose. It decides whether Swagger
# is exposed, whether CORS falls back to allowing localhost, and whether the
# production-only variables above are enforced — and every one of those used to
# fail OPEN when it was unset. `compose.yml` pins it to `production` unless you
# override it, so this value is for LOCAL use.
NODE_ENV=development
PORT=4010

# Swagger is served at /api. It is ON automatically in development and OFF
# everywhere else unless this is set — it used to be mounted unauthenticated in
# every environment, handing out a complete map of the API.
# ENABLE_SWAGGER=false
